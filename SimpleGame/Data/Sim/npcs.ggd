# ---- 산적 (붉은 두건) ----
[npc rocco]
name = 로코
title = 붉은 두건 두목
faction = bandits
region = home
traits = 2 -2 2
goal = plunder
likes = roast_meat
dislikes = herb_tea
actions = idle|rob|extort|drink
init_affinity = -50
power = 35
schedule = camp|road_east|road_east|camp
greet.hostile = 요리사 나부랭이가 국자 들고 어딜 기웃거려.\n가진 거 다 두고 꺼져.
greet.wary = 흥, 혼자 다니는 요리사라. 배짱은 봐줄 만하군.
greet.neutral = 네 국자 소문은 들었다. 우리 길을 막지만 마라.
greet.friendly = 한 그릇 얻어먹은 값은 한다. 동쪽 길은 오늘 조용할 거다.
bark.rob = 짐 내려놔! 붉은 두건 통행세다!
bark.stalk = 어이, 국자. 주머니가 무거워 보이는데?
bark.gossip = 오늘 턴 수레 얘기 해 줄까? 크하하!
cloth = 0.62 0.18 0.16
look = bandit

