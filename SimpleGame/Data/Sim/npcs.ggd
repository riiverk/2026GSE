# npcs.ggd — NPC 정의 (STORY_SIM.md 15.8)
#
# traits = 욕망 규범 기질 (각 -2 ~ +2)
#   욕망  - 절제 / + 탐욕      규범  - 실리 / + 원칙      기질  - 신중 / + 대담
# schedule = 새벽|낮|저녁|밤 의 맵 위치 id (고향 맵의 위치는 Game.cpp 위치 표)
# greet.<ally|friendly|neutral|wary|hostile> — 없는 단계는 neutral 로 대체
#
# 명세에 없는 화면용 키 (Sim 로직에는 영향 없음)
#   cloth = r g b          옷 색
#   look  = villager bandit merchant traveler hunter pilgrim bard noble villain official guard cloak
#   bark.<behavior> = ...  그 behavior 로 움직일 때 플레이어가 근처에 오면 하는 말
#
# 인코딩 UTF-8 BOM

# ===== 고향 — 튜토리얼 주민 12명 =====
[npc mira]
name = 미라
title = 방앗간 주인
faction = villagers
region = home
traits = -1 1 -1
goal = keep_promise
likes = grain_bread
actions = idle|tend_village
init_affinity = 30
init_trust = 30
power = 5
schedule = mill|square|mill|mill_house
greet.ally = 네 엄마도 떠나기 전날 딱 그 얼굴이었어.
greet.neutral = 방아 돌리는 소리 시끄럽지? 금방 끝나.
ask.mother_was_chilsung = 네 엄마? 칠성이었어.\n마을 사람들한테는 그냥 식당 아줌마였지만.
choice.seal_lake.text = 호수를 지켜 주세요. 봄에 검은 배가 올 거예요.
choice.seal_lake.cond = npc:mira.band >= 2 && faction:villagers.rep >= 40 && season == 3
choice.seal_lake.effect = flag home_sealed
cloth = 0.76 0.34 0.33
look = villager

[npc bruno]
name = 브루노
title = 사냥꾼
faction = villagers
region = home
traits = 0 0 1
goal = hunt
likes = lake_deer
actions = idle|hunt
init_affinity = 10
power = 15
schedule = house_2|forest_edge|square|house_2
greet.neutral = 강한 놈일수록 맛이 좋아.\n예나 지금이나 그건 안 변하지.
greet.friendly = 오늘 공터 쪽은 네가 먼저 돌아. 난 가장자리를 몰 테니.
greet.wary = 내가 쫓던 놈을 채 가다니. 사냥꾼 사이에도 예의라는 게 있어.
bark.hunt = 몰이 들어간다! 비켜!
cloth = 0.38 0.43 0.60
look = hunter

